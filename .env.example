# Server only — never prefix these with VITE_
DATABASE_URL=
XAI_API_KEY=
# Code teaching staff enter at /lecturer to join the staff room. Leave unset to
# keep staff registration closed (the preview database accepts DEMO-STAFF).
STAFF_ACCESS_CODE=

# Optional display name (default: Experiential Venture Platform)
VITE_APP_NAME=Experiential Venture Platform
