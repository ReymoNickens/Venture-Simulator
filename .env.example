# Server only — never prefix these with VITE_
DATABASE_URL=
XAI_API_KEY=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Optional Google/X sign-in — this app's OWN OAuth app credentials, no broker.
# Set both the server secret AND the matching VITE_ flag below to turn one on.
# Leave unset for email/password-only sign-in (works with none of these set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional display name (default: Experiential Venture Platform)
VITE_APP_NAME=Experiential Venture Platform
VITE_GOOGLE_AUTH_ENABLED=false
VITE_TWITTER_AUTH_ENABLED=false
