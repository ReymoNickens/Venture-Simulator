# Server only — never prefix these with VITE_
DATABASE_URL=
ANTHROPIC_API_KEY=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Code lecturers enter to create their account. Leave unset to keep lecturer
# sign-up closed (the preview database accepts DEMO-STAFF).
STAFF_ACCESS_CODE=

# Optional display name (default: Experiential Venture Platform)
VITE_APP_NAME=Experiential Venture Platform
# Home-screen label under the app icon (keep it to 12 characters).
# VITE_APP_SHORT_NAME=Venture
