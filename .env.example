# Server only — never prefix these with VITE_
DATABASE_URL=
ANTHROPIC_API_KEY=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Unlocks /owner (classes, lecturer logins). A long random phrase.
OWNER_ACCESS_CODE=
# SMS sign-in codes through Arkesel. Until both are set, codes wait on /owner.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=ENT302
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional display name (default: Experiential Venture Platform)
VITE_APP_NAME=Experiential Venture Platform
